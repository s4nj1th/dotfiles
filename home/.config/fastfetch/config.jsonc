{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "display": {
    "size": {
      "maxPrefix": "MB",
      "ndigits": 0,
      "spaceBeforeUnit": "never"
    },
    "freq": {
      "ndigits": 3,
      "spaceBeforeUnit": "never"
    }
  },

  "modules": [
    "title",
    "separator",

    "user",
    {
      "type": "users",
      "key": "Users"
    },
    "datetime",
    "host",
    "machine",
    "os",
    {
      "type": "kernel",
      "format": "{release}"
    },
    "uptime",
    "cpu",
    {
      "type": "gpu",
      "key": "GPU",
      "format": "{name}"
    },
    {
      "type": "memory",
      "format": "{used} / {total}"
    },
    "disk",
    "poweradapter",
    "terminal",
    "shell",

    "break",
    {
      "type": "colors",
      "symbol": "block",
      "block": {
        "range": [0, 7]
      }
    }
  ]
}
